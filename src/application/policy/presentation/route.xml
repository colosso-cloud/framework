<?xml version="1.0" encoding="UTF-8"?>
<Routes path="/api" >
    <!-- Views -->
    <Route path="/" type="view" view="auth/index.xml" method="GET" />
    <Route path="/inventory/repositories" layout="auth.xml" type="view" view="auth/test.xml" method="GET" />
    <Route path="/inventory/domains" type="view" view="auth/index.xml" method="GET" />
    <Route path="/inventory/services" type="view" view="auth/index.xml" method="GET" />
    <Route path="/inventory/volumes" type="view" view="auth/index.xml" method="GET" />
    <Route path="/inventory/containers" type="view" view="auth/index.xml" method="GET" />
    <Route path="/inventory/secrets" type="view" view="auth/index.xml" method="GET" />
    <Route path="/inventory/machines" type="view" view="auth/index.xml" method="GET" />
    <Route path="/ide" type="view" view="auth/index.xml" method="GET" />
    <Route path="/profile" type="view" view="auth/profile.xml" method="GET" />
    <Route path="/auth/signup" type="view" view="auth/registration.xml" method="GET" />
    <Route path="/auth/signin" type="view" view="auth/login.xml" method="GET" />
    <Route path="/auth/reset-password" type="view" view="auth/recovery.xml" method="GET" />
    
    <!-- Actions -->
    <Route path="/login" type="login" method="POST" />
    <Route path="/logout" type="logout" method="POST" />
    <Route path="/github/callback" type="login" method="GET" />
    <Route path="/gather" type="action" method="GET" policy="" />
    <Route path="/create" type="action" method="POST" policy="" />
    <Route path="/chat" type="action" method="POST" policy="" />
</Routes>