{% extends "mono.xml" %}
{% block content %}
<Navigation orientation="horizontal">
    <Action type="link" route="/home"><Text>Home</Text></Action>
    <Action type="dropdown">
        <Text>Products</Text>
        <Action type="link" route="/products/item1"><Text>Item 1</Text></Action>
        <Action type="link" route="/products/item2"><Text>Item 2</Text></Action>
        <Action type="link" route="/products/item3"><Text>Item 3</Text></Action>
    </Action>
    <Action type="link" route="/contact"><Text>Contact</Text></Action>
</Navigation>
<Navigation type="breadcrumb">
    <Action type="link" route="/home"><Text>Home</Text></Action>
    <Action type="link" route="/products"><Text>Products</Text></Action>
    <Action type="link" route="/products/item"><Text>Item</Text></Action>
</Navigation>
<Navigation type="pagination">
    <Action type="link" route="/page/1"><Text>1</Text></Action>
    <Action type="link" route="/page/2"><Text>2</Text></Action>
    <Action type="link" route="/page/3"><Text>3</Text></Action>
    <Action type="link" route="/page/next"><Text>Next</Text></Action>
    <Action type="link" route="/page/last"><Text>Last</Text></Action>
</Navigation>
<Media width="500px" height="500px" type="embed" src="https://www.youtube.com/embed/FkgC37ERJCY?si=RdT-GibC8pnJ5L1C" />
<Media width="500px" height="500px" type="video" src="https://www.w3schools.com/html/mov_bbb.mp4" controls="" autoplay="" />
<Text type="code">print("Hello, World!")</Text>
<Action width="100px" type="button" ><Media width="100px" type="image" src="https://img.animeunity.so/anime/bx143598-FCvAhQJLllSP.png" /></Action>
<Action type="form" action="/auth/login" >
    <Input type="text" name="username" placeholder="Username" />
    <Input type="password" name="password" placeholder="Password" />
    <Action type="submit" ><Text>Login</Text></Action>
</Action>

<Input type="select" name="gender" placeholder="gender" >
    <Text>Maschio</Text>
    <Text>Femmina</Text>
</Input>
<Window width="1980px" height="1080px" src="https://web.archive.org" />
<Message type="success" mode="alert" title="Alert" >
    <Text>This is an alert message.</Text>
</Message>
<Group>
    <Input type="text" name="name" placeholder="name" />
    <Input type="text" name="surname" placeholder="surname" />
</Group>
<Group type="list">
    <Text>Item 1</Text>
    <Text>Item 2</Text>
    <Text>Item 3</Text>
</Group>
<Group type="card">
    <Card>
        <Media width="100px" height="100px" type="image" src="https://img.animeunity.so/anime/bx143598-FCvAhQJLllSP.png" />
        <Text>Card 1</Text>
    </Card>
    <Card>
        <Media width="100px" height="100px" type="image" src="https://img.animeunity.so/anime/bx143598-FCvAhQJLllSP.png" />
        <Text>Card 2</Text>
    </Card>
    <Card>
        <Media width="100px" height="100px" type="image" src="https://img.animeunity.so/anime/bx143598-FCvAhQJLllSP.png" />
        <Text>Card 3</Text>
    </Card>
</Group>
<Media type="carousel" width="500px" height="500px">
    <Media type="image" src="https://img.animeunity.so/anime/bx143598-FCvAhQJLllSP.png" />
    <Media type="image" src="https://img.animeunity.so/anime/bx143598-FCvAhQJLllSP.png" />
    <Media type="image" src="https://img.animeunity.so/anime/bx143598-FCvAhQJLllSP.png" />
</Media>
<Data type="text" >
    <Text>This is a text data element.</Text>
</Data>
<Action type="link" route="#offcanvasExample"><Text>Offcanvas</Text></Action>
<Action type="link" route="#dialogExample"><Text>Dialog</Text></Action>
<Window type="still" id="offcanvasExample">
    <Text>This is an offcanvas window.</Text>
    <Action type="button" ><Text>Close</Text></Action>
</Window>
<Window type="dialog" id="dialogExample">
    <Text>This is an offcanvas window.</Text>
    <Action type="button" ><Text>Close</Text></Action>
</Window>
{% endblock %}