{% extends "sidebar.xml" %}
{% block bar %}
<Action route="/home"><Media type="icon" src="bi-pc-horizontal"/> <Text>Machines</Text></Action>
<Action route="/home"><Media type="icon" src="bi-box-seam"/> <Text>Containers</Text></Action>
<Action route="/home"><Media type="icon" src="bi-boxes"/> <Text>Services</Text></Action>
<Action route="/home"><Media type="icon" src="bi-bookmarks"/> <Text>Repositories</Text></Action>
<Action route="/home"><Media type="icon" src="bi-database"/> <Text>Volumes</Text></Action>
<Action route="/home"><Media type="icon" src="bi-globe"/> <Text>Domains</Text></Action>
{% endblock %}
{% block content %}
<Group type="input" class="rounded-0">
    <Input width="auto" type="search"></Input>
    <Group type="action" width="auto" alignment-content="center" class="input-group-text">
        <Action><Media type="icon" src="bi-exclamation-triangle" class="text-danger" /></Action>
        <Action><Media type="icon" src="bi-exclamation-triangle" class="text-danger" /></Action>
        <Action><Media type="icon" src="bi-exclamation-triangle" class="text-danger" /></Action>
    </Group>
    <Input width="auto" type="select"></Input>

</Group>
<Data type="table">
    <Data type="table.header">
        <Data type="table.cell">
            <Text>Header 1</Text>
        </Data>
        <Data type="table.cell">
            <Text>Header 2</Text>
        </Data>
        <Data type="table.cell">
            <Text>Header 3</Text>
        </Data>
    </Data>
    <Data type="table.body">
        {% for value in [1,2,3,1,1] %}
        <Data type="table.row">
            <Text class="placeholder w-25">Cell 1</Text>
            <Text class="placeholder w-100">Cell 1</Text>
            <Text class="placeholder w-50">Cell 1</Text>
        </Data>
        {% endfor %}
    </Data>
</Data>
<Group type="input" >
    <Group expand="dynamic" alignment-content="center" class="border-bottom">
        <Navigation type="pagination" class="h-100" >
            <Action type="link" route="{{ url|add('page',1) }}" ><Text>Previous</Text></Action>
            <Action type="link" route="{{ url|add('page',2) }}" ><Text>Next</Text></Action>
        </Navigation>
    </Group>
    <Text class="input-group-text">1 at 10 row from 200 rows for</Text>
    <Input width="80px" type="select">
        <Text>5</Text>
        <Text>10</Text>
        <Text>15</Text>
        <Text>20</Text>
        <Text>25</Text>
        <Text>30</Text>
        <Text>40</Text>
        <Text>50</Text>
    </Input>
    <Text class="input-group-text">rows for page</Text>
</Group>

{% endblock %}