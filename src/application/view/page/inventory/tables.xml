{% extends "sidebar.xml" %}
{% set name = url.path[-1].capitalize() %}
{% block title %}Overview{% endblock %}
{% block subtitle %}Keep track of your inventory {{name}}{% endblock %}
{% block bar %}
<Action type="link" route="{{url|route(url.path[0])}}"><Media type="icon" src="bi-view-list"/> <Text>Overview</Text></Action>
<Action type="link" route="{{url|route(url.path[0]+'/repositories/')}}"><Media type="icon" src="bi-bookmarks"/> <Text>Repositories</Text></Action>
<Action type="link" route="/inventory/services/"><Media type="icon" src="bi-kanban"/> <Text>Projects</Text></Action>
<Action type="link" route="/inventory/repositories/"><Media type="icon" src="bi-box-seam"/> <Text>Packages</Text></Action>
<Action type="link" route="/inventory/volumes/"><Media type="icon" src="bi-people"/> <Text>Teams</Text></Action>
{% endblock %}
{% block breadcrumb %}
<Action type="link" route="/{{url.path[0]}}"  ><Media type="icon" src="bi-speedometer2"/></Action>
<Action route="application/view/page/inventory/repositories.xml" ><Media type="icon" src="bi-bookmarks-fill"/><Text>{{name}}</Text></Action>
{% endblock %}
{% block content %}
<Container class="border-top border-bottom">
    <Table id="table_{{name}}"></Table>
    <!--<Table repository="repository" filter="{'eq':{'owner':'SottoMonte'}}" view="repository" create="wizard" delete="wizard" update="wizard">
        <Text click="table(id:'{{ component or '' }}',sortField:'name')">Repository</Text>
        <Text>Description</Text>
        <Text>Type</Text>
        <Text>Platform</Text>
        <Text>Language</Text>
        <Text>Updated</Text>
        <Text>Actions</Text>
    </Table>-->
</Container>
{% endblock %}