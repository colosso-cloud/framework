{% extends "auth.xml" %}
{% block main %}
<Row expand="dynamic" >
    {% block start %}
    {% endblock %}
    <Row>
        <Navigation orientation="vertical" class="bg-light">
        {% block bar %}
        {% endblock %}
        </Navigation>
    </Row>
    <Column expand="dynamic">
            <Navigation type="breadcrumb">
                <Action type="link" route="/home"><Text>Home</Text></Action>
                <Action type="link" route="/products"><Text>Products</Text></Action>
                <Action type="link" route="/products/item"><Text>Item</Text></Action>
            {% block breadcrumb %}
            {% endblock %}
            </Navigation>
        <Row>
            <Column >
                <Text>{% block title %}{% endblock %}</Text>
                <Text >{% block subtitle %}{% endblock %}</Text>
            </Column>
            <Row class="position-sticky">
                <Container>{% block action %}{% endblock %}</Container>
            </Row>
        </Row>
        <Column>
            <Container id="alerts">
                
            </Container>
            {% block content %}
            {% endblock %}
        </Column>
    </Column>
    {% block fine %}
    {% endblock %}
</Row>
{% endblock %}