<?xml version="1.0" encoding="UTF-8"?>
<Container id="{{component.id}}" >
    {% set rows = (url.query.get('row_'+component.id) or [5])[-1] | int %}
    {% set current_page = (url.query.get('page_'+component.id) or [1])[-1] | int %}
    <Group type="input" class="rounded-0">
        <Input width="auto" type="search" placeholder="search" class="rounded-0"></Input>
        <Group type="action" width="auto" alignment-content="center" class="input-group-text" expand="dynamic">
            
        </Group>
        <Group type="action" width="auto" alignment-content="center" class="input-group-text">
            <Action><Media type="icon" src="bi-plus-circle" class="text-success" /></Action>
            <Action><Media type="icon" src="bi-pencil" class="text-warning" /></Action>
            <Action><Media type="icon" src="bi-trash" class="text-danger" /></Action>
        </Group>
        <Input width="auto" class="rounded-0" placeholder="actions" type="select">
            <Text>actions</Text>
        </Input>
    </Group>
    <Data type="table">
        <Data type="table.header">
            <Data type="table.cell">
                <Text>Header 1</Text>
            </Data>
            <Data type="table.cell">
                <Text>Header 2</Text>
            </Data>
            <Data type="table.cell">
                <Text>Header 3</Text>
            </Data>
        </Data>
        <Data type="table.body">
            {% for value in range(rows) %}
            <Data type="table.row">
                <Text class="placeholder w-25">Cell 1</Text>
                <Text class="placeholder w-100">Cell 1</Text>
                <Text class="placeholder w-50">Cell 1</Text>
            </Data>
            {% endfor %}
        </Data>
    </Data>
    <Group type="input" >
        <Group expand="dynamic" alignment-content="center" class="border-bottom">
            <Navigation type="pagination" class="h-100" >
                <Action type="link" route="{{url|add('page_'+component.id,current_page-1)}}" class="border-start rounded-0" ><Text>Previous</Text></Action>
                {% for page in range(1,5) %}
                    {% if current_page == page %}
                <Action type="link" class="active" ><Text>{{page}}</Text></Action>
                    {% else %}
                <Action type="link" route="{{url|add('page_'+component.id,page)}}" class="border-start rounded-0"><Text>{{page}}</Text></Action>
                    {% endif %}
                {% endfor %}
                <Action type="link" route="{{url|add('page_'+component.id,current_page+1)}}" class="border-start border-end rounded-0" ><Text>Next</Text></Action>
            </Navigation>
        </Group>
        <Text class="input-group-text">1 at 10 row from 200 rows for</Text>
        <Input width="80px" type="select" event-change="route(`{{url|add('row_'+component.id,'${this.value}')}}`)" value="{{rows}}">
            {% for value_r in [5,10,15,20,25,30,40,50] %}
            <Text value="{{value_r}}" >{{value_r}}</Text>
            {% endfor %}
        </Input>
        <Text class="input-group-text rounded-0">rows for page</Text>
    </Group>
</Container>