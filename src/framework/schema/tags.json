{
    "Data": {"type": "dict", "schema": {}},
    "Resource": {
        "type": "dict",
        "schema": {
            "types": {
                "type": "string",
                "allowed": ["image", "video", "audio"]
            }
        }
    },
    "Media": {
        "type": "dict",
        "schema": {
            "types": {
                "type": "string",
                "allowed": ["image", "video", "audio", "embed"]
            }
        },
        "_type": {"image": "image", "video": "video", "audio": "audio", "embed": "embed"}
    },
    "Navigation": {"type": "dict", "schema": {}},
    "View": {
        "type": "dict", 
        "schema": {
            "route": {"type": "string"}
        },
        "_return": {"function": "mount_view", "args": ["route"]}
    },
    "Messenger": {"type": "dict", "schema": {}},
    "Defender": {"type": "dict", "schema": {}},
    "Column": {
        "type": "dict", 
        "schema": {},
        "_return": {"function": "render_widget", "args": ["Column"]}
    },
    "Row": {"type": "dict", "schema": {}},
    "Storekeeper": {"type": "dict", "schema": {}},
    "Input": {
        "type": "dict",
        "schema": {
            "types": {
                "type": "list",
                "allowed": ["text", "select", "checkbox", "textarea", "radio", "switch", "color", "range"]
            }
        }
    },
    "Action": {
        "type": "dict",
        "schema": {
            "default_type": {"type": "string", "allowed": ["button", "submit", "form"]},
            "types": {
                "type": "list",
                "allowed": ["button", "submit", "form"]
            },
            "map": {"type": "dict", "schema": {}}
        }
    },
    "Window": {"type": "dict", "schema": {}},
    "Text": {
        "type": "dict", 
        "schema": {
            "types": {
                "type": "string",
                "allowed": ["code", "text"],
                "default": "text"
            }
        },
        "_type": {"code": "code", "text": "text"}
    },
    "Group": {"type": "dict", "schema": {}},
    "Layout": {"type": "dict", "schema": {}}
}