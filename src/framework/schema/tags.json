{
    "Card": {
        "type": "dict",
        "schema": {
            "title": {"type": "string"},
            "subtitle": {"type": "string"},
            "image": {"type": "string"},
            "content": {"type": "string"}
        },
        "_return": {"function": "render_widget", "args": ["card"]}
    },
    "Data": {
        "type": "dict", 
        "schema": {
            "type": {
                "type": "string",
                "allowed": ["text", "video", "audio"]
            }
        },
        "_return": {"function": "render_widget", "args": ["data"]}
    },
    "Resource": {
        "type": "dict",
        "schema": {
            "type": {
                "type": "string",
                "allowed": ["image", "video", "audio"]
            }
        }
    },
    "Media": {
        "type": "dict", 
        "schema": {
            "controls": {"type": "string"},
            "autoplay": {"type": "string" },
            "width":{"type": "string"},
            "height":{"type": "string"},
            "type": {
                "type": "string",
                "allowed": ["image", "video", "audio", "embed", "carousel", "map"]
            },
            "src": {
                "type": "string"
            }
        },
        "_type": {"image": "image", "video": "video", "audio": "audio", "embed": "embed", "carousel": "carousel", "map": "map"}
    },
    "Navigation": {
        "type": "dict",
        "schema": {
            "orientation": {
                "type": "string",
                "allowed": ["horizontal", "vertical"],
                "default": "horizontal"
            },
            "type": {
                "type": "string",
                "allowed": ["bar", "breadcrumb", "pagination", "carousel"],
                "default": "bar"
            }
        },
        "_type": {
            "bar": "bar",
            "breadcrumb": "breadcrumb",
            "pagination": "pagination",
            "carousel": "carousel"
        }
    },
    "View": {
        "type": "dict", 
        "schema": {
            "route": {"type": "string"}
        },
        "_return": {"function": "mount_view", "args": ["route"]}
    },
    "Messenger": {"type": "dict", "schema": {}},
    "Message": {
        "type": "dict",
        "schema": {
            "title": {"type": "string"},
            "subtitle": {"type": "string"},
            "type": {
                "type": "string",
                "allowed": ["info", "success", "warning", "error"],
                "default": "info"
            },
            "mode": {
                "type": "string",
                "allowed": ["toast", "alert", "inline","banner"],
                "default": "toast"
            }
        },
        "_return": {"function": "render_widget", "args": ["message"]}
    },
    "Defender": {"type": "dict", "schema": {}},
    "Column": {
        "type": "dict",
        "schema": {
            "expand": {
                "type": "string"
            }
        },
        "_return": {"function": "render_widget", "args": ["Column"]}
    },
    "Row": {"type": "dict", "schema": {}},
    "Storekeeper": {"type": "dict", "schema": {}},
    "Input": {
        "type": "dict",
        "schema": {
            "width": {"type": "string"},
            "height": {"type": "string"},
            "required": {"type": "string"},
            "disabled": {"type": "string"},
            "readonly": {"type": "string"},
            "autofocus": {"type": "string"},
            "type": {
                "type": "string",
                "allowed": ["combobox","text", "select", "checkbox", "textarea", "radio", "switch", "color", "range","password","listbox"],
                "default": "text"
            },
            "name": {"type": "string"},
            "placeholder": {"type": "string"},
            "value": {"type": "string"}
        },
        "_return": {"function": "render_widget", "args": ["Input"]}
    },
    "Action": {
        "type": "dict",
        "schema": {
            "width": {"type": "string"},
            "height": {"type": "string"},
            "type": {
                "type": "string",
                "allowed": ["button", "submit", "form","dropdown", "link"],
                "default": "button"
            },
            "action": {
                "type": "string"
            },
            "route": {
                "type": "string"
            }
        },
        "_type": {"button": "action","submit": "action", "form": "action", "dropdown": "action", "link": "action"}
    },
    "Window": {
        "type": "dict", 
        "schema": {
            "id": {"type": "string"},
            "width": {"type": "string"},
            "height": {"type": "string"},
            "type": {
                "type": "string",
                "allowed": ["still","embed","dialog"],
                "default": "embed"
            },
            "src": {"type": "string"}
        },
        "_type": {"dialog": "modal", "still": "offcanvas", "embed": "embed"}
    },
    "Text": {
        "type": "dict", 
        "schema": {
            "width": {"type": "string"},
            "height": {"type": "string"},
            "type": {
                "type": "string",
                "allowed": ["code", "text"],
                "default": "text"
            }
        },
        "_input":"text",
        "_return": {"function": "render_widget", "args": ["Text"]}
    },
    "Group": {
        "type": "dict", 
        "schema": {
            "width": {"type": "string"},
            "height": {"type": "string"},
            "type": {
                "type": "string",
                "allowed": ["input", "list", "card", "tab"],
                "default": "input"
            }
        },
        "_return": {"function": "render_widget", "args": ["Group"]}
    }
}