{
    "Data": {"type": "dict", "schema": {}},
    "Resource": {
        "type": "dict",
        "schema": {
            "types": {
                "type": "string",
                "allowed": ["image", "video", "audio"]
            }
        }
    },
    "Media": {
        "type": "dict", 
        "schema": {
            "type": {
                "type": "string",
                "allowed": ["image", "video", "audio", "embed"]
            },
            "src": {
                "type": "string"
            }
        },
        "_type": {"image": "image", "video": "video", "audio": "audio", "embed": "embed"}
    },
    "Navigation": {"type": "dict", "schema": {}},
    "View": {
        "type": "dict", 
        "schema": {
            "route": {"type": "string"}
        },
        "_return": {"function": "mount_view", "args": ["route"]}
    },
    "Messenger": {"type": "dict", "schema": {}},
    "Defender": {"type": "dict", "schema": {}},
    "Column": {
        "type": "dict",
        "schema": {
            "expand": {
                "type": "string"
            }
        },
        "_return": {"function": "render_widget", "args": ["Column"]}
    },
    "Row": {"type": "dict", "schema": {}},
    "Storekeeper": {"type": "dict", "schema": {}},
    "Input": {
        "type": "dict",
        "schema": {
            "type": {
                "type": "string",
                "allowed": ["text", "select", "checkbox", "textarea", "radio", "switch", "color", "range","password"],
                "default": "text"
            },
            "name": {"type": "string"},
            "placeholder": {"type": "string"},
            "value": {"type": "string"}
        },
        "_return": {"function": "render_widget", "args": ["Input"]}
    },
    "Action": {
        "type": "dict",
        "schema": {
            "type": {
                "type": "string",
                "allowed": ["button", "submit", "form"],
                "default": "button"
            },
            "action": {
                "type": "string"
            }
        },
        "_type": {"button": "action", "video": "video", "audio": "audio", "embed": "embed"}
    },
    "Window": {"type": "dict", "schema": {}},
    "Text": {
        "type": "dict", 
        "schema": {
            "type": {
                "type": "string",
                "allowed": ["code", "text"],
                "default": "text"
            }
        },
        "_input":"text",
        "_return": {"function": "render_widget", "args": ["Text"]}
    },
    "Group": {"type": "dict", "schema": {}},
    "Layout": {"type": "dict", "schema": {}}
}